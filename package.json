{
  "name": "caerwyn",
  "displayName": "Caerwyn",
  "description": "Live Stream Multi-Chat VSCode Extension",
  "version": "0.0.1",
  "publisher": "funnansoftware",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/funnansoftware/caerwyn.git"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "caerwyn",
          "title": "Caerwyn",
          "icon": "media/caerwyn.svg"
        }
      ]
    },
    "views": {
      "caerwyn": [
        {
          "type": "webview",
          "id": "caerwyn.chatView",
          "name": "Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "caerwyn.openChat",
        "title": "Open Chat",
        "category": "Caerwyn"
      },
      {
        "command": "caerwyn.openChatSidebar",
        "title": "Open Chat in Sidebar",
        "category": "Caerwyn"
      },
      {
        "command": "caerwyn.signInTwitch",
        "title": "Sign In to Twitch",
        "category": "Caerwyn"
      },
      {
        "command": "caerwyn.signOutTwitch",
        "title": "Sign Out of Twitch",
        "category": "Caerwyn"
      },
      {
        "command": "caerwyn.signInYouTube",
        "title": "Sign In to YouTube",
        "category": "Caerwyn"
      },
      {
        "command": "caerwyn.signOutYouTube",
        "title": "Sign Out of YouTube",
        "category": "Caerwyn"
      },
      {
        "command": "caerwyn.addTwitchChannel",
        "title": "Add Twitch Channel…",
        "category": "Caerwyn"
      },
      {
        "command": "caerwyn.addYouTubeStream",
        "title": "Add YouTube Stream…",
        "category": "Caerwyn"
      },
      {
        "command": "caerwyn.removeSource",
        "title": "Remove Chat Source…",
        "category": "Caerwyn"
      },
      {
        "command": "caerwyn.reconnect",
        "title": "Reconnect",
        "category": "Caerwyn",
        "icon": "$(refresh)"
      },
      {
        "command": "caerwyn.clearChat",
        "title": "Clear Chat",
        "category": "Caerwyn",
        "icon": "$(clear-all)"
      },
      {
        "command": "caerwyn.clearHistory",
        "title": "Delete Saved Chat History…",
        "category": "Caerwyn"
      },
      {
        "command": "caerwyn.toggleSimulation",
        "title": "Toggle Simulated Chat",
        "category": "Caerwyn"
      },
      {
        "command": "caerwyn.simulateEvent",
        "title": "Simulate Chat Event…",
        "category": "Caerwyn",
        "icon": "$(beaker)"
      },
      {
        "command": "caerwyn.toggleChatControls",
        "title": "Pause or Resume Chat Controls",
        "category": "Caerwyn"
      },
      {
        "command": "caerwyn.simulateChatCommand",
        "title": "Simulate Chat Command…",
        "category": "Caerwyn"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "caerwyn.clearChat",
          "when": "activeWebviewPanelId == caerwyn.chat",
          "group": "navigation@1"
        },
        {
          "command": "caerwyn.reconnect",
          "when": "activeWebviewPanelId == caerwyn.chat",
          "group": "navigation@2"
        },
        {
          "command": "caerwyn.simulateEvent",
          "when": "activeWebviewPanelId == 'caerwyn.chat' && config.caerwyn.simulation.enabled",
          "group": "navigation@0"
        }
      ],
      "view/title": [
        {
          "command": "caerwyn.simulateEvent",
          "when": "view == caerwyn.chatView && config.caerwyn.simulation.enabled",
          "group": "navigation@0"
        },
        {
          "command": "caerwyn.clearChat",
          "when": "view == caerwyn.chatView",
          "group": "navigation@1"
        },
        {
          "command": "caerwyn.reconnect",
          "when": "view == caerwyn.chatView",
          "group": "navigation@2"
        },
        {
          "command": "caerwyn.openChat",
          "when": "view == caerwyn.chatView",
          "group": "1_open@0"
        }
      ]
    },
    "configuration": {
      "title": "Caerwyn",
      "properties": {
        "caerwyn.maxMessages": {
          "type": "integer",
          "default": 500,
          "minimum": 50,
          "maximum": 5000,
          "description": "How many recent chat messages to keep and show."
        },
        "caerwyn.showTimestamps": {
          "type": "boolean",
          "default": false,
          "description": "Show the time next to each chat message."
        },
        "caerwyn.history.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Save chat messages on this computer, so a viewer's user card shows what they said in earlier streams, grouped by day. Only chat Caerwyn has read is saved; simulated chat never is. Run **Caerwyn: Delete Saved Chat History…** to remove it."
        },
        "caerwyn.youtube.transport": {
          "type": "string",
          "enum": [
            "stream",
            "poll"
          ],
          "default": "stream",
          "enumDescriptions": [
            "Keep one streaming connection open. Uses far less YouTube API quota.",
            "Poll for new messages every few seconds. Uses quota on every poll; only for when streaming does not work."
          ],
          "description": "How YouTube live chat is read."
        },
        "caerwyn.controls.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "markdownDescription": "Let viewers in your own chat run commands, such as `!theme`, that change your editor. Only your own Twitch channel and YouTube broadcast, added with **Sign In**, are listened to: never a chat you only read. A status bar item shows when controls are on; click it, or run **Caerwyn: Pause or Resume Chat Controls**, to stop them at once."
        },
        "caerwyn.controls.delaySeconds": {
          "type": "number",
          "default": 5,
          "minimum": 0,
          "maximum": 60,
          "scope": "application",
          "markdownDescription": "How long to hold a viewer's command before carrying it out, so a moderator can delete the message first. A deleted message, or a viewer timed out or banned, cancels it. Your own commands and your moderators' run at once."
        },
        "caerwyn.controls.replies": {
          "type": "string",
          "enum": [
            "off",
            "problems",
            "all"
          ],
          "default": "off",
          "scope": "application",
          "enumDescriptions": [
            "Caerwyn never posts in chat.",
            "Answer !help, and tell viewers why their command did not run.",
            "Also confirm what a command did, such as \"Monokai for 5 min\"."
          ],
          "markdownDescription": "Whether Caerwyn replies to viewers in your Twitch chat, from your account. Replies start with 🤖, never repeat what a viewer typed, and are limited to a few every 30 seconds. Switching replies on asks you to sign in to Twitch again, to grant permission to send chat messages. YouTube chat gets no replies yet."
        },
        "caerwyn.controls.commands": {
          "type": "object",
          "default": {},
          "scope": "application",
          "markdownDescription": "Changes to each chat command's defaults, by command name without the `!`. For example `{ \"theme\": { \"allowed\": \"subscriber\", \"cooldownSeconds\": 120 } }`.",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "enabled": {
                "type": "boolean",
                "description": "Set to false to switch this command off."
              },
              "allowed": {
                "type": "string",
                "enum": [
                  "everyone",
                  "subscriber",
                  "vip",
                  "moderator",
                  "broadcaster"
                ],
                "enumDescriptions": [
                  "Anyone in chat.",
                  "Subscribers (YouTube members) and above.",
                  "VIPs and above.",
                  "Moderators and you.",
                  "Only you."
                ],
                "description": "Who may use this command. Each level includes those above it."
              },
              "cooldownSeconds": {
                "type": "number",
                "minimum": 0,
                "description": "Seconds after anyone uses the command before anyone can use it again. You are never held back."
              },
              "userCooldownSeconds": {
                "type": "number",
                "minimum": 0,
                "description": "Seconds after a viewer uses the command before that viewer can use it again."
              }
            }
          }
        },
        "caerwyn.controls.theme.durationSeconds": {
          "type": "number",
          "default": 300,
          "minimum": 10,
          "maximum": 3600,
          "scope": "application",
          "markdownDescription": "How long a color theme picked with `!theme` stays before yours comes back. Pausing chat controls puts yours back at once."
        },
        "caerwyn.controls.theme.choices": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Theme names."
            },
            {
              "type": "object",
              "description": "Short names mapped to theme names.",
              "propertyNames": {
                "pattern": "^[A-Za-z0-9]{1,12}$",
                "not": {
                  "enum": [
                    "random",
                    "RANDOM",
                    "Random"
                  ]
                }
              },
              "additionalProperties": {
                "type": "string"
              }
            }
          ],
          "default": [],
          "scope": "application",
          "markdownDescription": "The color themes chat may pick with `!theme`, by the names shown in **Preferences: Color Theme**. Either a list, `[\"Monokai\", \"Abyss\"]`, or short names for chat to type, mapped to theme names: `{ \"cat\": \"Catppuccin Mocha\", \"kai\": \"Monokai\" }`. Short names are 1 to 12 letters or digits; `!help theme` lists them. Leave empty to allow every installed theme."
        },
        "caerwyn.simulation.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Show simulated Twitch and YouTube chat, for developing and trying out Caerwyn without signing in."
        },
        "caerwyn.simulation.messagesPerSecond": {
          "type": "number",
          "default": 2,
          "minimum": 0,
          "maximum": 50,
          "description": "How fast simulated chat arrives. Set to 0 to produce only the events you request with \"Caerwyn: Simulate Chat Event…\"."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile",
    "check-types": "tsc --noEmit && tsc --noEmit -p src/webview",
    "lint": "eslint src",
    "test": "vscode-test",
    "watch:tsc-webview": "tsc --noEmit --watch --project src/webview/tsconfig.json"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/vscode": "1.100.0",
    "@types/ws": "^8.18.2",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0"
  },
  "dependencies": {
    "ws": "^8.23.0"
  },
  "activationEvents": [
    "onWebviewPanel:caerwyn.chat"
  ]
}
