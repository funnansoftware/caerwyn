{
  "compilerOptions": {
    "module": "Node16",
    "target": "ES2022",
    "lib": ["ES2022"],
    "sourceMap": true,
    "rootDir": "src",
    "strict": true,
    "types": ["node", "mocha", "vscode"]
  },
  "include": ["src"],
  // The webview runs in a browser context and is type-checked by src/webview/tsconfig.json.
  "exclude": ["src/webview"]
}
